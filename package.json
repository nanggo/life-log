{
	"name": "sveltekit-blog-template",
	"version": "0.0.1",
	"sideEffects": [
		"**/*.css",
		"**/*.scss",
		"**/*.sass",
		"**/*.less"
	],
	"scripts": {
		"dev": "node scripts/copy-images.js && vite dev",
		"build": "node scripts/copy-images.js && vite build",
		"post": "vite-node scripts/create-post.ts",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint --ignore-path .gitignore .",
		"format": "prettier --write .",
		"seo:validate": "node scripts/seo-validation.js",
		"seo:validate:built": "node scripts/seo-validation.js --no-build",
		"indexnow:submit": "node scripts/submit-indexnow.js",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"analyze": "npx vite-bundle-analyzer .svelte-kit/output/client",
		"prepare": "svelte-kit sync && husky"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.3.2",
		"@sveltejs/kit": "2.69.1",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/typography": "^0.5.7",
		"@testing-library/jest-dom": "^6.6.4",
		"@testing-library/svelte": "^5.3.1",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^24.0.15",
		"@typescript-eslint/eslint-plugin": "^8.38.0",
		"@typescript-eslint/parser": "^8.38.0",
		"@vcarl/remark-headings": "^0.0.1",
		"@vitest/coverage-v8": "^4.1.0",
		"@vitest/ui": "^4.1.0",
		"autoprefixer": "^10.4.8",
		"cssnano": "^5.1.13",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-svelte": "^2.35.1",
		"fs-extra": "^11.3.0",
		"glob": "^11.1.0",
		"husky": "^9.1.7",
		"jsdom": "^26.1.0",
		"lint-staged": "^16.1.2",
		"mdsvex": "^0.11.0",
		"mdsvex-relative-images": "^1.0.3",
		"postcss": "^8.5.18",
		"postcss-load-config": "^4.0.1",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"rehype-autolink-headings": "^5.1.0",
		"rehype-slug": "^4.0.1",
		"remark-reading-time": "^1.0.1",
		"rollup-plugin-visualizer": "^6.0.3",
		"sharp": "^0.35.0",
		"svelte": "5.55.7",
		"svelte-check": "^4.2.2",
		"svelte-preprocess": "^6.0.0",
		"tailwindcss": "^3.1.8",
		"typescript": "^5.3.3",
		"unist-util-visit": "^3.1.0",
		"vite": "^6.4.3",
		"vite-bundle-analyzer": "^1.1.0",
		"vite-node": "^3.2.4",
		"vite-plugin-compression2": "^2.2.0",
		"vitest": "^4.1.0"
	},
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"pnpm": {
		"overrides": {
			"lodash": "4.18.1",
			"rollup": "4.60.3",
			"tar": "7.5.15",
			"ajv@<6.14.0": "6.14.0",
			"brace-expansion@<1.1.13": "1.1.13",
			"cookie@<0.7.0": "0.7.2",
			"flatted@<3.4.2": "3.4.2",
			"glob@>=10.2.0 <10.5.0": "10.5.0",
			"js-yaml@<3.14.2": "3.14.2",
			"minimatch@<3.1.4": "3.1.4",
			"minimatch@>=9.0.0 <9.0.7": "9.0.7",
			"minimatch@>=10.0.0 <10.2.3": "10.2.3",
			"picomatch@>=2.0.0 <2.3.2": "2.3.2",
			"svgo@>=2.1.0 <2.8.3": "2.8.3",
			"ws@>=8.0.0 <8.20.1": "8.20.1",
			"yaml@<1.10.3": "1.10.3",
			"yaml@>=2.0.0 <2.8.3": "2.8.3"
		}
	},
	"lint-staged": {
		"*.{js,ts}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.svelte": [
			"prettier --write --plugin=prettier-plugin-svelte",
			"eslint --fix"
		],
		"*.{json,md,css,html}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@vercel/analytics": "^1.3.1",
		"@vercel/speed-insights": "^1.0.12",
		"clsx": "^1.2.1",
		"date-fns": "^2.29.1",
		"github-slugger": "^2.0.0",
		"gray-matter": "^4.0.3",
		"heroicons-svelte": "^2.0.2",
		"node-html-parser": "^5.4.1",
		"reading-time": "^1.5.0"
	}
}
